# Copy to .env for local development. All credentials below are placeholders.
# Never commit .env or put server secrets in VITE_* variables.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend listener; scripts/start.ps1 reads these through backend.config.settings.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Public frontend hosts; Funnel supports the ts.net name. torilo.net also needs
# a custom-domain ingress/TLS service such as Cloudflare Tunnel or Caddy.
FRONTEND_URL=http://localhost:5173,https://ai.softshell-diminished.ts.net,https://torilo.net,https://www.torilo.net
VITE_ALLOWED_HOSTS=ai.softshell-diminished.ts.net,torilo.net,www.torilo.net
VITE_API_URL=
API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_PORT=5173
FRONTEND_PREVIEW_PORT=4173

# LLM provider (required to start the production assistant)
OPENAI_API_KEY=
LLM_MODEL=

# OpenAI embedding model used by the persistent Chroma RAG index.
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL local development placeholders
POSTGRES_DB=torilo_ai
POSTGRES_USER=torilo
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://torilo:change-me-local-only@localhost:5432/torilo_ai

# Optional remote vector-store settings; local development uses persistent ChromaDB.
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=torilo_knowledge_base