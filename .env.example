# Copy to .env for local development. All credentials below are placeholders.
# Never commit .env or put server secrets in VITE_* variables.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend origin (FastAPI CORS allowlist)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# LLM provider (required to start the production assistant)
OPENAI_API_KEY=
LLM_MODEL=

# Embedding provider (future production adapter; Phase 1 uses local hash embeddings)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL local development placeholders
POSTGRES_DB=torilo_ai
POSTGRES_USER=torilo
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://torilo:change-me-local-only@localhost:5432/torilo_ai

# Vector store (provider selection/configuration is deferred)
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=torilo_knowledge_base